{
  "format_version": "0.1",
  "protocol": {
    "id": "VAKE.SignedDH",
    "fragment_description": "Two-role ephemeral Diffie-Hellman exchange in which each role signs its share with a long-term signing key and verifies the peer's signature with the expected peer's public key before deriving and accepting the shared secret. Its bundled scenarios show honest key agreement and a substituted share that fails signature verification, so no key is accepted. No universal authentication or secrecy claim is made."
  },
